-- // 🚪 DOORS ULTIMATE SCRIPT | ПК И МОБИЛЬНЫЕ УСТРОЙСТВА 🚪 //
-- // Все функции, красивый GUI, кнопка полёта на телефоне, ESP, уведомления //

-- 1. ИНИЦИАЛИЗАЦИЯ С ЗАЩИТОЙ ОТ ОШИБОК
local success, err = pcall(function()

    -- Сервисы
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local Workspace = game:GetService("Workspace")
    local Lighting = game:GetService("Lighting")
    local TweenService = game:GetService("TweenService")

    local LocalPlayer = Players.LocalPlayer
    if not LocalPlayer then
        repeat task.wait() until Players.LocalPlayer
        LocalPlayer = Players.LocalPlayer
    end

    -- Определяем тип устройства
    local isMobile = UserInputService.TouchEnabled

    -- 2. НАСТРОЙКИ
    local Settings = {
        -- ESP
        ESP_Monsters = true,
        ESP_Items = true,
        ESP_Doors = true,
        ESP_Closets = true,
        ESP_Books = true,
        ESP_Players = true,
        -- Player
        GodMode = true,
        Noclip = true,
        Fly = false,
        SpeedHack = 24,
        JumpPower = 50,
        Fullbright = true,
        -- World
        AutoUnlock = true,
        AutoCollect = true,
        MonsterWarnings = true
    }

    -- 3. КОНФИГУРАЦИЯ МОНСТРОВ (ЦВЕТА, ДИСТАНЦИИ, ПРЕДУПРЕЖДЕНИЯ)
    local MonsterConfig = {
        Rush = {color = Color3.fromRGB(255, 100, 0), dist = 150, msg = "⚠️ RUSH! ПРЯЧЬСЯ! ⚠️"},
        Ambush = {color = Color3.fromRGB(0, 255, 100), dist = 150, msg = "⚠️ AMBUSH! ВОЗВРАЩАЕТСЯ! ⚠️"},
        Seek = {color = Color3.fromRGB(255, 0, 0), dist = 200, msg = "👁️ SEEK! БЕГИ! 👁️"},
        Figure = {color = Color3.fromRGB(150, 0, 255), dist = 120, msg = "🦯 FIGURE! ТИХО! 🦯"},
        Screech = {color = Color3.fromRGB(255, 255, 0), dist = 60, msg = "🦇 SCREECH! СМОТРИ В ГЛАЗА! 🦇"},
        Halt = {color = Color3.fromRGB(0, 255, 255), dist = 100, msg = "🚦 HALT! СТОЙ И ИДИ! 🚦"},
        Eyes = {color = Color3.fromRGB(255, 0, 255), dist = 80, msg = "👀 ГЛАЗА! НЕ СМОТРИ! 👀"},
        Hide = {color = Color3.fromRGB(139, 69, 19), dist = 50, msg = "😡 HIDE! ВЫЛЕЗАЙ ИЗ ШКАФА! 😡"},
        Timothy = {color = Color3.fromRGB(255, 192, 203), dist = 20, msg = "🕷️ TIMOTHY В СУНДУКЕ! 🕷️"},
        Jack = {color = Color3.fromRGB(255, 255, 255), dist = 30, msg = "🎭 JACK! НЕ ВХОДИ В ШКАФ! 🎭"},
        Shadow = {color = Color3.fromRGB(128, 128, 128), dist = 40, msg = "👻 ТЕНЬ! ПРОСТО СМОТРИТ! 👻"},
        Glitch = {color = Color3.fromRGB(0, 255, 0), dist = 100, msg = "💻 ГЛИТЧ! НЕ ЗАСТРЕВАЙ! 💻"},
        Dupe = {color = Color3.fromRGB(255, 165, 0), dist = 50, msg = "🚪 DUPE! ПРОВЕРЬ ДВЕРЬ! 🚪"},
        Snare = {color = Color3.fromRGB(0, 100, 0), dist = 10, msg = "🌿 ЛОВУШКА! НЕ НАСТУПИ! 🌿"}
    }

    -- 4. GUI (АДАПТИВНЫЙ)
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DoorsUltimateGUI"
    ScreenGui.Parent = CoreGui

    local guiWidth, guiHeight = 300, 520
    if isMobile then
        guiWidth, guiHeight = 350, 580
    end

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, guiWidth, 0, guiHeight)
    MainFrame.Position = UDim2.new(0.5, -guiWidth/2, 0.5, -guiHeight/2)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    MainFrame.BackgroundTransparency = 0.1
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui

    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 16)
    local stroke = Instance.new("UIStroke", MainFrame)
    stroke.Color = Color3.fromRGB(0, 255, 255)
    stroke.Thickness = 3
    stroke.Transparency = 0.4

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 50)
    Title.BackgroundTransparency = 1
    Title.Text = "🚪 DOORS ULTIMATE 🚪"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = isMobile and 24 or 20
    Title.Font = Enum.Font.GothamBlack
    Title.Parent = MainFrame

    local TitleGradient = Instance.new("UIGradient", Title)
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 200)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 255))
    })
    TitleGradient.Rotation = 45

    local CloseButton = Instance.new("TextButton")
    CloseButton.Size = UDim2.new(0, 36, 0, 36)
    CloseButton.Position = UDim2.new(1, -44, 0, 7)
    CloseButton.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    CloseButton.BackgroundTransparency = 0.3
    CloseButton.Text = "✕"
    CloseButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    CloseButton.TextSize = 26
    CloseButton.Font = Enum.Font.GothamBold
    CloseButton.Parent = MainFrame
    Instance.new("UICorner", CloseButton).CornerRadius = UDim.new(0, 12)
    CloseButton.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    local ScrollingFrame = Instance.new("ScrollingFrame")
    ScrollingFrame.Size = UDim2.new(1, -20, 1, -60)
    ScrollingFrame.Position = UDim2.new(0, 10, 0, 55)
    ScrollingFrame.BackgroundTransparency = 1
    ScrollingFrame.ScrollBarThickness = isMobile and 8 or 5
    ScrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 200)
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 1000)
    ScrollingFrame.Parent = MainFrame

    -- Функция создания тоггла
    local function createToggle(name, settingName, yPos, icon)
        local btnHeight = isMobile and 55 or 45
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, btnHeight)
        btn.Position = UDim2.new(0, 5, 0, yPos)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        btn.BackgroundTransparency = 0.4
        btn.BorderSizePixel = 0
        btn.Text = icon .. " " .. name .. ": " .. (Settings[settingName] and "✅ ВКЛ" or "❌ ВЫКЛ")
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = isMobile and 16 or 14
        btn.Font = Enum.Font.GothamSemibold
        btn.Parent = ScrollingFrame

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
        local bStroke = Instance.new("UIStroke", btn)
        bStroke.Color = Color3.fromRGB(0, 255, 200)
        bStroke.Thickness = 2
        bStroke.Transparency = 0.5

        btn.MouseButton1Click:Connect(function()
            Settings[settingName] = not Settings[settingName]
            btn.Text = icon .. " " .. name .. ": " .. (Settings[settingName] and "✅ ВКЛ" or "❌ ВЫКЛ")
        end)

        return btn
    end

    -- Создаём все кнопки
    createToggle("ESP Монстры", "ESP_Monsters", 15, "👁️")
    createToggle("ESP Предметы", "ESP_Items", 80, "📦")
    createToggle("ESP Двери", "ESP_Doors", 145, "🚪")
    createToggle("ESP Шкафы", "ESP_Closets", 210, "🗄️")
    createToggle("ESP Книги", "ESP_Books", 275, "📚")
    createToggle("ESP Игроки", "ESP_Players", 340, "👤")
    createToggle("Неуязвимость", "GodMode", 405, "🛡️")
    createToggle("Noclip", "Noclip", 470, "🚧")
    createToggle("Ускорение x1.5", "SpeedHack", 535, "⚡")
    createToggle("Супер-прыжок", "JumpPower", 600, "🦘")
    createToggle("Полное освещение", "Fullbright", 665, "💡")
    createToggle("Авто-двери", "AutoUnlock", 730, "🔓")
    createToggle("Авто-сбор", "AutoCollect", 795, "💰")
    createToggle("Предупреждения", "MonsterWarnings", 860, "📢")
    createToggle("Полёт (ПК: F)", "Fly", 925, "🪽")

    -- 5. СПЕЦИАЛЬНАЯ КНОПКА ПОЛЁТА ДЛЯ ТЕЛЕФОНА
    if isMobile then
        local FlyButton = Instance.new("TextButton")
        FlyButton.Size = UDim2.new(0, 80, 0, 80)
        FlyButton.Position = UDim2.new(1, -100, 1, -150)
        FlyButton.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        FlyButton.BackgroundTransparency = 0.3
        FlyButton.Text = "🪽\nПОЛЁТ"
        FlyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlyButton.Font = Enum.Font.GothamBold
        FlyButton.TextSize = 18
        FlyButton.Parent = ScreenGui
        Instance.new("UICorner", FlyButton).CornerRadius = UDim.new(0, 40)
        local fStroke = Instance.new("UIStroke", FlyButton)
        fStroke.Color = Color3.fromRGB(0, 255, 255)
        fStroke.Thickness = 3

        local flyState = false
        FlyButton.MouseButton1Click:Connect(function()
            flyState = not flyState
            Settings.Fly = flyState
            FlyButton.BackgroundColor3 = flyState and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(0, 150, 200)
            FlyButton.Text = flyState and "🪽\nСТОП" or "🪽\nПОЛЁТ"
        end)
    end

    -- 6. ПРЕДУПРЕЖДЕНИЯ О МОНСТРАХ (GUI)
    local WarningFrame = Instance.new("Frame")
    WarningFrame.Size = UDim2.new(0, 300, 0, 70)
    WarningFrame.Position = UDim2.new(0.5, -150, 0.1, 0)
    WarningFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    WarningFrame.BackgroundTransparency = 0.2
    WarningFrame.Visible = false
    WarningFrame.Parent = ScreenGui
    Instance.new("UICorner", WarningFrame).CornerRadius = UDim.new(0, 12)
    Instance.new("UIStroke", WarningFrame).Color = Color3.fromRGB(255, 0, 0)

    local WarnTitle = Instance.new("TextLabel", WarningFrame)
    WarnTitle.Size = UDim2.new(1, 0, 0, 30)
    WarnTitle.BackgroundTransparency = 1
    WarnTitle.Text = "⚠️ ОПАСНОСТЬ ⚠️"
    WarnTitle.TextColor3 = Color3.fromRGB(255, 100, 100)
    WarnTitle.Font = Enum.Font.GothamBlack
    WarnTitle.TextSize = 22

    local WarnDist = Instance.new("TextLabel", WarningFrame)
    WarnDist.Size = UDim2.new(1, 0, 0, 20)
    WarnDist.Position = UDim2.new(0, 0, 0, 35)
    WarnDist.BackgroundTransparency = 1
    WarnDist.Text = "Расстояние: 0m"
    WarnDist.TextColor3 = Color3.fromRGB(200, 200, 200)
    WarnDist.Font = Enum.Font.Gotham
    WarnDist.TextSize = 14

    -- 7. ФУНКЦИОНАЛЬНАЯ ЧАСТЬ

    -- Персонаж
    local function onChar(char)
        local hum = char:WaitForChild("Humanoid")
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if Settings.GodMode and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end)
        hum.WalkSpeed = Settings.SpeedHack and Settings.SpeedHack or 24
        hum.JumpPower = Settings.JumpPower and Settings.JumpPower or 50
    end

    if LocalPlayer.Character then onChar(LocalPlayer.Character) end
    LocalPlayer.CharacterAdded:Connect(onChar)

    -- Noclip
    RunService.Stepped:Connect(function()
        if Settings.Noclip and LocalPlayer.Character then
            for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)

    -- Fullbright
    if Settings.Fullbright then
        Lighting.Brightness = 2
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.FogEnd = 100000
    end

    -- Полёт (универсальный)
    local flying = false
    local flySpeed = 50
    local bg, bv

    local function startFly()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        flying = true
        bg = Instance.new("BodyGyro", root)
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.CFrame = root.CFrame
        bv = Instance.new("BodyVelocity", root)
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        hum.PlatformStand = true
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    local function stopFly()
        flying = false
        if bg then bg:Destroy() end
        if bv then bv:Destroy() end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.PlatformStand = false end
    end

    -- Управление полётом: ПК - клавиша F, телефон - через Settings.Fly (меняется кнопкой)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if not isMobile and input.KeyCode == Enum.KeyCode.F then
            Settings.Fly = not Settings.Fly
            if Settings.Fly then startFly() else stopFly() end
        end
    end)

    -- Отслеживание Settings.Fly для телефона
    spawn(function()
        local lastFly = false
        while true do
            if Settings.Fly ~= lastFly then
                lastFly = Settings.Fly
                if Settings.Fly then startFly() else stopFly() end
            end
            task.wait(0.1)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if flying and Settings.Fly and LocalPlayer.Character then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local cam = Workspace.CurrentCamera
                local move = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
                if bv then bv.Velocity = move * flySpeed end
                if bg then bg.CFrame = cam.CFrame end
            end
        end
    end)

    -- ESP (подсветка объектов)
    local function createHighlight(obj, color, text)
        if obj:FindFirstChild("ESP_Highlight") then return end
        local h = Instance.new("Highlight")
        h.Name = "ESP_Highlight"
        h.FillColor = color
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.Parent = obj
        local bgui = Instance.new("BillboardGui", obj)
        bgui.Name = "ESP_Label"
        bgui.Size = UDim2.new(0, 100, 0, 30)
        bgui.StudsOffset = Vector3.new(0, 3, 0)
        bgui.AlwaysOnTop = true
        local lbl = Instance.new("TextLabel", bgui)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextStrokeTransparency = 0
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
    end

    local function isMonster(obj)
        local name = obj.Name:lower()
        for monster, cfg in pairs(MonsterConfig) do
            if name:find(monster:lower()) then return monster, cfg end
        end
        return nil
    end

    RunService.Heartbeat:Connect(function()
        if not LocalPlayer.Character then return end
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local closestMonster, closestDist, closestCfg

        for _, obj in ipairs(Workspace:GetDescendants()) do
            local highlight = obj:FindFirstChild("ESP_Highlight")
            local label = obj:FindFirstChild("ESP_Label")
            local shouldShow = false
            local color = Color3.fromRGB(255, 255, 255)
            local display = obj.Name

            -- Монстры
            local mName, mCfg = isMonster(obj)
            if mName and Settings.ESP_Monsters then
                shouldShow = true
                color = mCfg.color
                display = mName
                if Settings.MonsterWarnings then
                    local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                    local dist = (pos - root.Position).Magnitude
                    if dist <= mCfg.dist then
                        if not closestMonster or dist < closestDist then
                            closestMonster, closestDist, closestCfg = mName, dist, mCfg
                        end
                    end
                end
            end

            -- Предметы
            if not shouldShow and Settings.ESP_Items then
                local nl = obj.Name:lower()
                if obj:IsA("Tool") or nl:find("key") or nl:find("lockpick") or nl:find("vitamin") or nl:find("flashlight") or nl:find("lighter") or nl:find("gold") or nl:find("coin") or nl:find("battery") then
                    shouldShow = true
                    color = Color3.fromRGB(255, 255, 0)
                    display = "📦 " .. obj.Name
                end
            end

            -- Двери
            if not shouldShow and Settings.ESP_Doors then
                if obj:IsA("Model") and obj.Name:lower():find("door") then
                    shouldShow = true
                    color = Color3.fromRGB(0, 255, 0)
                    display = "🚪 " .. obj.Name
                end
            end

            -- Шкафы
            if not shouldShow and Settings.ESP_Closets then
                local nl = obj.Name:lower()
                if obj:IsA("Model") and (nl:find("wardrobe") or nl:find("closet") or nl:find("bed")) then
                    shouldShow = true
                    color = Color3.fromRGB(139, 69, 19)
                    display = "🗄️ " .. obj.Name
                end
            end

            -- Книги
            if not shouldShow and Settings.ESP_Books then
                local nl = obj.Name:lower()
                if obj:IsA("BasePart") and (nl:find("book") or nl:find("paper")) then
                    shouldShow = true
                    color = Color3.fromRGB(255, 215, 0)
                    display = "📚 " .. obj.Name
                end
            end

            -- Игроки
            if not shouldShow and Settings.ESP_Players then
                if obj:IsA("Model") then
                    local plr = Players:GetPlayerFromCharacter(obj)
                    if plr and plr ~= LocalPlayer then
                        shouldShow = true
                        color = Color3.fromRGB(0, 100, 255)
                        display = "👤 " .. plr.Name
                    end
                end
            end

            if shouldShow then
                if not highlight and not label then
                    createHighlight(obj, color, display)
                end
                if label then
                    local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                    local dist = math.floor((pos - root.Position).Magnitude)
                    label.TextLabel.Text = display .. " [" .. dist .. "m]"
                end
            else
                if highlight then highlight:Destroy() end
                if label then label:Destroy() end
            end
        end

        -- Показываем уведомление
        if closestMonster and closestCfg then
            WarningFrame.Visible = true
            WarnTitle.Text = closestCfg.msg
            WarnTitle.TextColor3 = closestCfg.color
            WarnDist.Text = "Расстояние: " .. math.floor(closestDist) .. "m"
        else
            WarningFrame.Visible = false
        end
    end)

    -- Авто-открытие и авто-сбор
    spawn(function()
        while true do
            if LocalPlayer.Character then
                local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    if Settings.AutoUnlock then
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if obj:IsA("Model") and obj.Name:lower():find("door") then
                                for _, p in ipairs(obj:GetDescendants()) do
                                    if p:IsA("ProximityPrompt") then
                                        pcall(function() p:InputHoldBegin() task.wait(0.2) p:InputHoldEnd() end)
                                    end
                                end
                            end
                        end
                    end
                    if Settings.AutoCollect then
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                                firetouchinterest(root, obj.Handle, 0)
                                firetouchinterest(root, obj.Handle, 1)
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)

    print("✅ DOORS ULTIMATE SCRIPT активирован! Приятной игры!")
end)

if not success then
    warn("❌ Ошибка скрипта: " .. tostring(err))
end
