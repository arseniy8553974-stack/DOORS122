    -- 4. АДАПТИВНЫЙ GUI
    local ScreenGui = Instance.new("ScreenGui", CoreGui)
    ScreenGui.Name = "DoorsUltimateGUI"

    local guiW, guiH = isMobile and 350 or 300, isMobile and 580 or 520
    local Main = Instance.new("Frame", ScreenGui)
