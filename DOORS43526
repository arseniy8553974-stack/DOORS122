    Title.TextSize = isMobile and 22 or 20; Title.Font = Enum.Font.GothamBlack
    Instance.new("UIGradient", Title).Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0,255,200)),
